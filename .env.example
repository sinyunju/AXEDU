# 앱
APP_ENV=dev
DATABASE_URL=sqlite:///./easyclass.db
STORAGE_DIR=./storage
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173

# 인증
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720

# AI
MOCK_AI=true
AI_BASE_URL=https://api.baze.co/v1/gateway
AI_API_KEY=
MODEL_FAST=gemini-3.5-flash-lite
MODEL_MAIN=gemini-3.8-flash
MODEL_IMAGE=gemini-nano-banana-2.1
