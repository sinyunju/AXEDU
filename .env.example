# 앱
APP_ENV=dev
DATABASE_URL=sqlite:///./easyclass.db
STORAGE_DIR=./storage
MAX_UPLOAD_MB=30
MAX_PDF_PAGES=100
PDF_RENDER_ZOOM=1.5
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173

# 인증
# 32바이트 이상 랜덤 문자열. 생성: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720

# AI
MOCK_AI=true
# 이미지 생성 mock. 실제 호출은 1장에 약 37크레딧이라 텍스트와 따로 제어
MOCK_IMAGE=true
AI_BASE_URL=https://api.baze.co/v1/gateway
AI_API_KEY=
MODEL_MAIN=gemini-3.8-flash
# 실시간 자막 모델. 비우면 MODEL_MAIN. 빠른 모델(gemini-3.5-flash-lite)은 1~2초로 빠르지만 용어 교정·설명 누락이 많음
MODEL_LIVE=
MODEL_IMAGE=gemini-nano-banana-2.1
IMAGE_SIZE=1K
IMAGE_ASPECT_RATIO=1:1
AI_TIMEOUT_SECONDS=90
GENERATE_CONCURRENCY=3
LIVE_CAPTION_INTERVAL_SECONDS=15
CHAT_HISTORY_LIMIT=10
