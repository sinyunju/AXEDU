# true면 백엔드 없이 브라우저 안의 목 데이터로 동작합니다.
# 백엔드(FastAPI)에 붙일 때는 false로 바꾸세요.
VITE_USE_MOCK=true

# 백엔드 주소. 목 모드가 꺼져 있을 때 사용합니다.
# 휴대폰·태블릿에서 접속하면 localhost는 "그 기기 자신"이라, PC의 IP로 적어야 합니다 (예: http://192.168.0.10:8000)
# 그리고 백엔드 .env의 FRONTEND_ORIGINS에 프론트 주소(예: http://192.168.0.10:5173)를 추가해야 CORS에 막히지 않습니다.
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
