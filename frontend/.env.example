# true면 백엔드 없이 브라우저 안의 목 데이터로 동작합니다.
# 백엔드(FastAPI)에 붙일 때는 false로 바꾸세요.
VITE_USE_MOCK=true

# 백엔드 주소. auto(또는 비워 두면)는 "지금 연 페이지 주소의 8000번 포트"를 씁니다.
#   PC(http://localhost:5173) → http://localhost:8000
#   아이패드(http://PC의IP:5173) → http://PC의IP:8000  (와이파이가 바뀌어 IP가 달라져도 그대로)
# 다른 기기에서 열 때는 백엔드 .env의 FRONTEND_ORIGINS에 http://PC의IP:5173 을 추가해야 CORS에 막히지 않습니다.
# 배포(Vercel)할 때는 auto 대신 실제 주소를 적으세요 (https://…, wss://…). README "배포 (Vercel)" 참고.
VITE_API_BASE_URL=auto
VITE_WS_BASE_URL=auto
